# ==============================================================================
# SPICE & SLICE - BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port (Render / Railway / Heroku injects this automatically)
PORT=5000

# Environment Mode
NODE_ENV=production

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/spice_and_slice
# MongoDB Atlas Cloud URI format:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/spice_and_slice?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/spice_and_slice

# Allowed Frontend URL for CORS (e.g. Vercel deployment)
# Example: https://spice-and-slice.vercel.app
CLIENT_URL=https://your-frontend-domain.vercel.app
